# Copy to .env.local and fill in values. Never commit real values.

# ---------------------------------------------------------------------------
# Server-only. Read these only in server code (Route Handlers, Server Actions,
# Server Components, pages/api). They must never use the NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
API_BASE_URL=
API_HMAC_SECRET=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Public. Everything prefixed NEXT_PUBLIC_ is compiled into the browser bundle.
# Only add values that are safe to publish (site keys, DSNs, restricted keys).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SENTRY_DSN=
